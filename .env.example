# Copy to .env and fill in your Google OAuth client id to enable
# Google Drive synchronization.
#  1. Create an OAuth client id at https://console.cloud.google.com/apis/credentials
#  2. Add the following as an authorized JavaScript origin: http://localhost:5173
#  3. Enable the Google Drive API for your project.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
